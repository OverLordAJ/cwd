  <script>
    /* ─────────────────────────────────────────
       CHART DEFAULTS
    ───────────────────────────────────────── */
    Chart.defaults.color = '#8a8480';
    Chart.defaults.font.family = "'IBM Plex Sans', sans-serif";
    Chart.defaults.font.size = 12;

    const accent  = '#e8c97e';
    const muted   = '#2a2a2a';
    const gridCol = 'rgba(255,255,255,0.05)';

    /* ─────────────────────────────────────────
       CHART 1 — OVERALL ADOPTION (horizontal bar)
    ───────────────────────────────────────── */
    const ctx1 = document.getElementById('chart1').getContext('2d');
    new Chart(ctx1, {
      type: 'bar',
      data: {
        labels: ['YouTube','Facebook','Instagram','Pinterest','TikTok','LinkedIn','Snapchat','WhatsApp','Twitter / X','Reddit'],
        datasets: [{
          label: '% of US adults',
          data: [83, 68, 47, 35, 33, 30, 27, 23, 22, 22],
          backgroundColor: [
            '#ff4e4e','#4e8cff','#c96dcc','#e87e7e','#4ecfb5',
            '#6e9fff','#f5d64e','#6bde8f','#9a9aff','#ff9a4e'
          ],
          borderRadius: 4,
          borderSkipped: false,
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: ctx => ` ${ctx.parsed.x}% of US adults`
            }
          }
        },
        scales: {
          x: {
            grid: { color: gridCol },
            ticks: { callback: v => v + '%' },
            max: 100
          },
          y: {
            grid: { display: false },
            ticks: { color: '#c4bfb8' }
          }
        }
      }
    });

    /* ─────────────────────────────────────────
       CHART 2 — BY AGE GROUP (grouped bar)
    ───────────────────────────────────────── */
    const ctx2 = document.getElementById('chart2').getContext('2d');
    new Chart(ctx2, {
      type: 'bar',
      data: {
        labels: ['18–29', '30–49', '50–64', '65+'],
        datasets: [
          {
            label: 'YouTube',
            data: [93, 87, 75, 53],
            backgroundColor: '#ff4e4e',
            borderRadius: 3,
          },
          {
            label: 'Facebook',
            data: [67, 75, 68, 58],
            backgroundColor: '#4e8cff',
            borderRadius: 3,
          },
          {
            label: 'Instagram',
            data: [78, 59, 35, 15],
            backgroundColor: '#c96dcc',
            borderRadius: 3,
          },
          {
            label: 'TikTok',
            data: [62, 39, 24, 10],
            backgroundColor: '#4ecfb5',
            borderRadius: 3,
          },
          {
            label: 'Snapchat',
            data: [65, 30, 13, 4],
            backgroundColor: '#f5d64e',
            borderRadius: 3,
          }
        ]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'top',
            labels: {
              color: '#c4bfb8',
              usePointStyle: true,
              pointStyle: 'rectRounded',
              padding: 16
            }
          },
          tooltip: {
            callbacks: {
              label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y}%`
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: '#c4bfb8' }
          },
          y: {
            grid: { color: gridCol },
            ticks: { callback: v => v + '%' },
            max: 100
          }
        }
      }
    });

    /* ─────────────────────────────────────────
       CHART 3 — OVER TIME (line chart)
    ───────────────────────────────────────── */
    const ctx3 = document.getElementById('chart3').getContext('2d');

    // Shared year axis — sparse data uses null for missing years
    const years = [2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023];

    const facebookData  = [67, 71, 71, 72, 79, null, 68, 69, null, 69, null, 68];
    const instagramData = [13, 17, 26, null, 32, null, 35, 37, null, 40, null, 47];
    const youtubeData   = [null, null, null, null, null, null, 73, 73, null, 81, null, 83];
    const tiktokData    = [null, null, null, null, null, null, null, null, 21, 21, null, 33];
    const twitterData   = [16, 18, 23, null, 24, null, 24, 22, null, 23, null, 22];

    const lineDefaults = { fill: false, tension: 0.35, borderWidth: 2.5, pointRadius: 4, pointHoverRadius: 6, spanGaps: true };

    new Chart(ctx3, {
      type: 'line',
      data: {
        labels: years,
        datasets: [
          { ...lineDefaults, label: 'Facebook',  data: facebookData,  borderColor: '#4e8cff', pointBackgroundColor: '#4e8cff' },
          { ...lineDefaults, label: 'Instagram', data: instagramData, borderColor: '#c96dcc', pointBackgroundColor: '#c96dcc' },
          { ...lineDefaults, label: 'YouTube',   data: youtubeData,   borderColor: '#ff4e4e', pointBackgroundColor: '#ff4e4e' },
          { ...lineDefaults, label: 'TikTok',    data: tiktokData,    borderColor: '#4ecfb5', pointBackgroundColor: '#4ecfb5', borderDash: [5,3] },
          { ...lineDefaults, label: 'Twitter/X', data: twitterData,   borderColor: '#9a9aff', pointBackgroundColor: '#9a9aff', borderDash: [3,3] },
        ]
      },
      options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: {
            position: 'top',
            labels: {
              color: '#c4bfb8',
              usePointStyle: true,
              pointStyle: 'rectRounded',
              padding: 16
            }
          },
          tooltip: {
            callbacks: {
              label: ctx => ctx.parsed.y !== null ? ` ${ctx.dataset.label}: ${ctx.parsed.y}%` : null,
              filter: item => item.parsed.y !== null
            }
          }
        },
        scales: {
          x: {
            grid: { color: gridCol },
            ticks: { color: '#c4bfb8' }
          },
          y: {
            grid: { color: gridCol },
            ticks: { callback: v => v + '%' },
            min: 0,
            max: 100
          }
        }
      }
    });

    /* ─────────────────────────────────────────
       INTERSECTION OBSERVER — fade-in on scroll
    ───────────────────────────────────────── */
    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
  </script>

</body>
</html>
