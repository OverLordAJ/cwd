  <!-- Google Fonts: Playfair Display + IBM Plex Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

  <style>
    :root {
      --bg: #0e0e0e;
      --bg-card: #161616;
      --bg-muted: #1c1c1c;
      --text: #f0ece3;
      --text-muted: #8a8480;
      --accent: #e8c97e;
      --accent-dim: #5a4b2a;
      --border: #2a2a2a;
      --font-display: 'Playfair Display', Georgia, serif;
      --font-body: 'IBM Plex Sans', sans-serif;
      --youtube:  #ff4e4e;
      --facebook: #4e8cff;
      --instagram:#c96dcc;
      --tiktok:   #4ecfb5;
      --snapchat: #f5d64e;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-weight: 400;
      font-size: 1rem;
      line-height: 1.75;
    }

    /* ── SKIP LINK (accessibility) ── */
    .skip-link {
      position: absolute;
      top: -100%;
      left: 1rem;
      background: var(--accent);
      color: #000;
      padding: .4rem .8rem;
      font-weight: 600;
      z-index: 9999;
      border-radius: 4px;
      transition: top .2s;
    }
    .skip-link:focus { top: 1rem; }

    /* ── NAVIGATION ── */
    nav.top-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(14,14,14,.92);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
      padding: .75rem 0;
    }
    nav.top-nav .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 860px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    nav.top-nav .site-label {
      font-size: .7rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    nav.top-nav .section-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
    }
    nav.top-nav .section-links a {
      font-size: .75rem;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--text-muted);
      text-decoration: none;
      transition: color .2s;
    }
    nav.top-nav .section-links a:hover,
    nav.top-nav .section-links a:focus { color: var(--accent); }

    /* ── HERO ── */
    .hero {
      min-height: 92vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 6rem 1.5rem 4rem;
      max-width: 860px;
      margin: 0 auto;
    }
    .hero .kicker {
      font-size: .72rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.25rem;
      display: block;
    }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 6vw, 4.8rem);
      font-weight: 900;
      line-height: 1.08;
      margin-bottom: 1.5rem;
      color: var(--text);
    }
    .hero h1 em {
      font-style: italic;
      color: var(--accent);
    }
    .hero .deck {
      max-width: 560px;
      font-size: 1.15rem;
      color: #b8b2a9;
      line-height: 1.7;
      margin-bottom: 2.5rem;
    }
    .hero .byline {
      font-size: .75rem;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
      padding-top: 1rem;
    }
    .hero .byline span { color: var(--accent); }

    /* ── DIVIDER ── */
    .section-divider {
      border: none;
      border-top: 1px solid var(--border);
      margin: 0;
    }

    /* ── PROSE SECTION ── */
    .prose-section {
      max-width: 860px;
      margin: 0 auto;
      padding: 5rem 1.5rem;
    }
    .prose-section .section-number {
      display: block;
      font-size: .68rem;
      letter-spacing: .25em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: .75rem;
    }
    .prose-section h2 {
      font-family: var(--font-display);
      font-size: clamp(1.7rem, 3.5vw, 2.6rem);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 1.5rem;
      color: var(--text);
    }
    .prose-section p {
      max-width: 640px;
      color: #b8b2a9;
      font-size: 1.05rem;
      margin-bottom: 1.1rem;
    }
    .prose-section p strong { color: var(--text); font-weight: 600; }

    /* ── CHART CONTAINERS ── */
    .chart-wrap {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2rem;
      margin-top: 2.5rem;
    }
    .chart-wrap .chart-title {
      font-size: .72rem;
      letter-spacing: .15em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }
    .chart-wrap canvas { max-height: 480px; }

    /* ── STAT CALLOUTS ── */
    .stat-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
      margin-top: 2.5rem;
    }
    .stat-card {
      background: var(--bg-muted);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.25rem 1.25rem 1rem;
    }
    .stat-card .stat-val {
      font-family: var(--font-display);
      font-size: 2.6rem;
      font-weight: 900;
      color: var(--accent);
      line-height: 1;
      display: block;
    }
    .stat-card .stat-label {
      font-size: .78rem;
      color: var(--text-muted);
      margin-top: .4rem;
      line-height: 1.4;
    }

    /* ── PLATFORM LEGEND BADGES ── */
    .platform-legend {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      margin: 1rem 0 0;
    }
    .platform-badge {
      font-size: .72rem;
      letter-spacing: .06em;
      padding: .25rem .65rem;
      border-radius: 20px;
      border: 1px solid;
      font-weight: 500;
    }
    .pb-yt  { color: var(--youtube);   border-color: var(--youtube); }
    .pb-fb  { color: var(--facebook);  border-color: var(--facebook); }
    .pb-ig  { color: var(--instagram); border-color: var(--instagram); }
    .pb-tt  { color: var(--tiktok);    border-color: var(--tiktok); }
    .pb-sc  { color: var(--snapchat);  border-color: var(--snapchat); }

    /* ── SOURCE NOTE ── */
    .source-note {
      font-size: .72rem;
      color: var(--text-muted);
      margin-top: 1rem;
      border-top: 1px solid var(--border);
      padding-top: .75rem;
    }
    .source-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

    /* ── PULLQUOTE ── */
    .pullquote {
      border-left: 3px solid var(--accent);
      padding: 1rem 1.5rem;
      margin: 2rem 0;
      font-family: var(--font-display);
      font-size: 1.45rem;
      font-style: italic;
      color: var(--text);
      line-height: 1.45;
      background: var(--bg-muted);
      border-radius: 0 6px 6px 0;
    }

    /* ── FOOTER ── */
    footer {
      max-width: 860px;
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
      border-top: 1px solid var(--border);
    }
    footer .footer-label {
      font-size: .68rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1rem;
      display: block;
    }
    footer p { font-size: .88rem; color: var(--text-muted); max-width: 600px; margin-bottom: .6rem; }
    footer a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

    /* ── RESPONSIVE TWEAKS ── */
    @media (max-width: 600px) {
      nav.top-nav .section-links { display: none; }
      .chart-wrap { padding: 1.25rem; }
      .stat-row { grid-template-columns: 1fr 1fr; }
    }

    /* ── FADE-IN ANIMATION ── */
    .fade-in {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity .65s ease, transform .65s ease;
    }
    .fade-in.visible {
      opacity: 1;
      transform: none;
    }
  </style>
</head>
